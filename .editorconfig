root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Windows PowerShell 5.1 reads non-ASCII scripts correctly only with a BOM.
[*.{ps1,psm1}]
charset = utf-8-bom
end_of_line = crlf
indent_size = 4

[*.{cmd,bat}]
end_of_line = crlf
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2
